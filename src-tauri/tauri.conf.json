{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cantina",
  "version": "0.1.0",
  "identifier": "com.jbouder.cantina",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cantina",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "resources": {
      "../kits/": "kits/",
      "../irs/": "irs/",
      "../pedals/": "pedals/",
      "../patterns/": "patterns/",
      "../rigs/": "rigs/",
      "../jams/": "jams/",
      "../exercises/": "exercises/",
      "../courses/": "courses/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist",
      "hardenedRuntime": true
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU1QzQ0OTYwNjRCOEMwRDcKUldUWHdMaGtZRW5FNVpDS1NabFExWllKeVlycXQ5akNSR0Q4RUhPMEFKbjhWUjA4NllEdkZpY0kK",
      "endpoints": [
        "https://github.com/jbouder/cantina/releases/latest/download/latest.json"
      ]
    }
  }
}
