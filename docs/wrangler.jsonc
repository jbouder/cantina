{
  // The Cantina documentation site: static assets on Cloudflare Workers.
  // Astro prerenders every page; there is no Worker script, binding or
  // secret. `npm run deploy` builds and uploads ./dist.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cantina-docs",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
