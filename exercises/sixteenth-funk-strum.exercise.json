    "tonic": "E",
    "mode": "major"
  },
  "tempo": {
    "start": 70,
    "goal": 110,
    "step": 4
  },
  "countIn": 1,
  "rig": "funk-clean",
  "drums": {
    "kit": "vintage",
    "groove": "Funk",
    "levelDb": -4
  },
