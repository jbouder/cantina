{
  "name": "cantina",
  "private": true,
  "version": "0.1.0",
  "description": "A Mac desktop studio for guitar and bass players",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "biome check . && node scripts/check-colors.mjs && node scripts/check-scale.mjs && node scripts/check-contrast.mjs",
    "format": "biome check --write .",
    "typecheck": "tsc -b packages/scenes && tsc --noEmit -p tsconfig.json && tsc --noEmit -p packages/scenes/test",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test",
    "test:scenes": "node scripts/scene-harness.mjs"
  },
  "dependencies": {
    "@cantina/scenes": "*",
    "@cantina/skins": "*",
    "@fontsource/vt323": "^5.3.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "workspaces": [
    "packages/*"
  ]
}
