{
  // The scenes came from music-visualizer, written without unchecked
  // index access; they build as their own project so the app's stricter
  // settings check only what the app writes.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "composite": true,
    "emitDeclarationOnly": true,
    "outDir": "../../node_modules/.cache/scenes-types",
    "rootDir": ".",
    "types": ["vite/client", "node"]
  },
  "include": ["src"]
}
