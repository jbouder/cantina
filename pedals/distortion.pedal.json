{
  "version": 1,
  "name": "Distortion",
  "params": [
    {
      "id": "drive",
      "label": "Drive",
      "unit": "dB",
      "min": 0,
      "max": 60,
      "default": 30
    },
    {
      "id": "tone",
      "label": "Tone",
      "unit": "Hz",
      "min": 500,
      "max": 8000,
      "default": 3000
    },
    {
      "id": "level",
      "label": "Level",
      "unit": "dB",
      "min": -24,
      "max": 6,
      "default": -12
    },
    {
      "id": "curve",
      "label": "Curve",
      "choices": [
        "Hard",
        "Soft",
        "Fold"
      ],
      "default": 0
    },
    {
      "id": "oversampling",
      "label": "Oversampling",
      "choices": [
        "Off",
        "2×",
        "4×",
        "8×"
      ],
      "default": 2
    }
  ],
  "nodes": [
    {
      "id": "in",
      "kind": "input",
      "pos": [
        40,
        160
      ]
    },
    {
      "id": "pre",
      "kind": "biquad",
      "type": "highpass",
      "freq": 60,
      "pos": [
        260,
        160
      ]
    },
    {
      "id": "mid",
      "kind": "biquad",
      "type": "peak",
      "freq": 900,
      "gain": 6,
      "q": 0.7,
      "pos": [
        480,
        160
      ]
    },
    {
      "id": "drive",
      "kind": "gain",
      "db": {
        "param": "drive",
        "map": [
          6,
          66
        ]
      },
      "smooth": 0.01,
      "pos": [
        700,
        160
      ]
    },
    {
      "id": "clip",
      "kind": "waveshaper",
      "curve": {
        "param": "curve",
        "values": [
          "hard",
          "soft",
          "fold"
        ]
      },
      "oversample": {
        "param": "oversampling",
        "values": [
          1,
          2,
          4,
          8
        ]
      },
      "pos": [
        920,
        160
      ]
    },
    {
      "id": "post",
      "kind": "biquad",
      "type": "highpass",
      "freq": 20,
      "pos": [
        1140,
        160
      ]
    },
    {
      "id": "tone",
      "kind": "biquad",
      "type": "lowpass",
      "freq": {
        "param": "tone"
      },
      "smooth": 0.01,
      "pos": [
        1360,
        160
      ]
    },
    {
      "id": "level",
      "kind": "gain",
      "db": {
        "param": "level"
      },
      "smooth": 0.01,
      "pos": [
        1580,
        160
      ]
    },
    {
      "id": "out",
      "kind": "output",
      "pos": [
        1800,
        160
      ]
    }
  ],
  "edges": [
    [
      "in",
      "pre"
    ],
    [
      "pre",
      "mid"
    ],
    [
      "mid",
      "drive"
    ],
    [
      "drive",
      "clip"
    ],
    [
      "clip",
      "post"
    ],
    [
      "post",
      "tone"
    ],
    [
      "tone",
      "level"
    ],
    [
      "level",
      "out"
    ]
  ]
}
